{%- comment -%}
  NOZ · Section 06 — WHO IS IT FOR
  Running · Cycling · CrossFit · Gym · Padel · Hiking
{%- endcomment -%}
{% render 'noz-head' %}

{%- liquid
  assign sid = section.id
  assign acc = section.settings.accent_color
  assign bg = section.settings.bg_color
-%}

<section class="noz noz-section noz-who" id="noz-who-{{ sid }}"
  style="--noz-accent: {{ acc }}; --noz-bg: {{ bg }};">
  <div class="noz-wrap">
    <div class="noz-head noz-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="noz-eyebrow noz-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="noz-h2 noz-reveal" data-delay="1">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}<p class="noz-lead noz-reveal" data-delay="2">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>

    <div class="noz-who__grid">
      {%- for block in section.blocks -%}
        <article class="noz-who__card noz-reveal" data-delay="{{ forloop.index | modulo: 6 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="noz-who__media">
              {{ block.settings.image | image_url: width: 700 | image_tag:
                loading: 'lazy', sizes: '(max-width: 749px) 45vw, 30vw',
                widths: '300,450,600,700', alt: block.settings.label }}
            </div>
          {%- endif -%}
          <div class="noz-who__inner">
            <span class="noz-who__ico">{% render 'noz-icon', icon: block.settings.icon, size: 26 %}</span>
            <span class="noz-who__label">{{ block.settings.label }}</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ sid }} .noz-who__grid {
    display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: clamp(12px,1.5vw,20px); }
  #shopify-section-{{ sid }} .noz-who__card {
    position: relative; aspect-ratio: 1 / 1.05; border-radius: var(--noz-radius); overflow: hidden;
    background: linear-gradient(180deg, var(--noz-surface), var(--noz-bg-2));
    border: 1px solid var(--noz-line); transition: border-color .4s, transform .4s var(--noz-ease); }
  #shopify-section-{{ sid }} .noz-who__card:hover { border-color: var(--noz-accent); transform: translateY(-6px); }
  #shopify-section-{{ sid }} .noz-who__media { position: absolute; inset: 0; }
  #shopify-section-{{ sid }} .noz-who__media img {
    width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(.5) contrast(1.05);
    transition: filter .5s, transform .6s var(--noz-ease); }
  #shopify-section-{{ sid }} .noz-who__card:hover .noz-who__media img { filter: grayscale(.2) brightness(.62); transform: scale(1.06); }
  #shopify-section-{{ sid }} .noz-who__card::after {
    content: ""; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(180deg, rgba(8,8,8,.1), rgba(8,8,8,.85)); }
  #shopify-section-{{ sid }} .noz-who__inner {
    position: absolute; inset: auto 0 0 0; z-index: 2; padding: clamp(16px,2vw,24px);
    display: flex; align-items: center; gap: 14px; }
  #shopify-section-{{ sid }} .noz-who__ico {
    width: 46px; height: 46px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--noz-accent-soft); color: var(--noz-accent); flex: 0 0 auto; transition: background .3s, color .3s; }
  #shopify-section-{{ sid }} .noz-who__card:hover .noz-who__ico { background: var(--noz-accent); color: #060a00; }
  #shopify-section-{{ sid }} .noz-who__label {
    font-family: var(--noz-font-head); font-weight: 900; text-transform: uppercase; letter-spacing: .02em;
    font-size: clamp(1.05rem, 1.6vw, 1.4rem); color: var(--noz-white); }

  @media (max-width: 749px) { #shopify-section-{{ sid }} .noz-who__grid { grid-template-columns: repeat(2, 1fr); } }
{% endstyle %}

{% schema %}
{
  "name": "NOZ · Para quién",
  "tag": "section",
  "class": "noz-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Para quién" },
    { "type": "text", "id": "title", "label": "Título", "default": "Para cada respiración. Para cada meta." },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Da igual tu disciplina: si respiras, rindes más con NOZ." },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "accent_color", "label": "Color de acento", "default": "#C6F000" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#080808" }
  ],
  "blocks": [
    {
      "type": "discipline",
      "name": "Disciplina",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "options": [
          { "value": "running", "label": "Running" },
          { "value": "cycling", "label": "Cycling" },
          { "value": "crossfit", "label": "CrossFit" },
          { "value": "gym", "label": "Gym" },
          { "value": "padel", "label": "Pádel" },
          { "value": "hiking", "label": "Hiking" },
          { "value": "cardio", "label": "Cardio" },
          { "value": "mountain", "label": "Montaña" } ], "default": "running" },
        { "type": "text", "id": "label", "label": "Nombre", "default": "Running" },
        { "type": "image_picker", "id": "image", "label": "Imagen de fondo (opcional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "NOZ · Para quién",
      "blocks": [
        { "type": "discipline", "settings": { "icon": "running", "label": "Running" } },
        { "type": "discipline", "settings": { "icon": "cycling", "label": "Cycling" } },
        { "type": "discipline", "settings": { "icon": "crossfit", "label": "CrossFit" } },
        { "type": "discipline", "settings": { "icon": "gym", "label": "Gym" } },
        { "type": "discipline", "settings": { "icon": "padel", "label": "Pádel" } },
        { "type": "discipline", "settings": { "icon": "hiking", "label": "Hiking" } }
      ]
    }
  ]
}
{% endschema %}
