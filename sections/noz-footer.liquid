{%- comment -%}
  NOZ · Section 10 — FOOTER
{%- endcomment -%}
{% render 'noz-head' %}

{%- liquid
  assign sid = section.id
  assign acc = section.settings.accent_color
  assign bg = section.settings.bg_color
-%}

<footer class="noz noz-section noz-footer" id="noz-footer-{{ sid }}"
  style="--noz-accent: {{ acc }}; --noz-bg: {{ bg }};">

  {%- if section.settings.show_marquee -%}
    <div class="noz-footer__marquee" aria-hidden="true">
      <div class="noz-footer__marquee-track">
        {%- for i in (1..2) -%}
          {%- assign items = section.settings.marquee_text | split: '·' -%}
          {%- for item in items -%}
            <span>{{ item | strip }}</span><i>{% render 'noz-icon', icon: 'airflow', size: 18 %}</i>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="noz-wrap noz-footer__top">
    <div class="noz-footer__brand">
      <span class="noz-footer__logo">{{ section.settings.logo_text | default: 'NOZ' }}</span>
      <p class="noz-footer__tagline">{{ section.settings.tagline }}</p>
      {%- if section.settings.blurb != blank -%}<p class="noz-footer__blurb">{{ section.settings.blurb }}</p>{%- endif -%}
      <div class="noz-footer__social">
        {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">{% render 'noz-icon', icon: 'instagram', size: 20 %}</a>
        {%- endif -%}
        {%- if section.settings.tiktok != blank -%}
          <a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">{% render 'noz-icon', icon: 'tiktok', size: 20 %}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="noz-footer__cols">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="noz-footer__col" {{ block.shopify_attributes }}>
            <h3 class="noz-footer__col-title">{{ block.settings.heading }}</h3>
            <ul>
              {%- if block.settings.link_list != blank -%}
                {%- for link in block.settings.link_list.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- if block.settings.l1_label != blank -%}<li><a href="{{ block.settings.l1_link | default: '#' }}">{{ block.settings.l1_label }}</a></li>{%- endif -%}
                {%- if block.settings.l2_label != blank -%}<li><a href="{{ block.settings.l2_link | default: '#' }}">{{ block.settings.l2_label }}</a></li>{%- endif -%}
                {%- if block.settings.l3_label != blank -%}<li><a href="{{ block.settings.l3_link | default: '#' }}">{{ block.settings.l3_label }}</a></li>{%- endif -%}
                {%- if block.settings.l4_label != blank -%}<li><a href="{{ block.settings.l4_link | default: '#' }}">{{ block.settings.l4_label }}</a></li>{%- endif -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.show_newsletter -%}
        <div class="noz-footer__col noz-footer__news">
          <h3 class="noz-footer__col-title">{{ section.settings.news_heading | default: 'Newsletter' }}</h3>
          <p>{{ section.settings.news_text }}</p>
          {%- form 'customer', class: 'noz-footer__form', data-noz-form: '', data-native: 'true' -%}
            <input type="hidden" name="contact[tags]" value="newsletter, noz-footer">
            <div class="noz-footer__field">
              <label class="noz-visually-hidden" for="noz-footer-{{ sid }}-email">Correo</label>
              <input id="noz-footer-{{ sid }}-email" type="email" name="contact[email]" placeholder="tu@email.com" required autocomplete="email">
              <button type="submit" aria-label="Suscribirme">{% render 'noz-icon', icon: 'arrow-right', size: 18 %}</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="noz-form-msg is-ok" data-form-msg>¡Gracias por suscribirte!</p>
            {%- else -%}
              <p class="noz-form-msg" data-form-msg></p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="noz-wrap noz-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: 'NOZ' }}. {{ section.settings.rights | default: 'Todos los derechos reservados.' }}</p>
    {%- if section.settings.legal_label != blank -%}
      <a href="{{ section.settings.legal_link | default: '#' }}">{{ section.settings.legal_label }}</a>
    {%- endif -%}
  </div>
</footer>

{% style %}
  #shopify-section-{{ sid }} .noz-footer { padding-top: 0; }

  #shopify-section-{{ sid }} .noz-footer__marquee {
    background: var(--noz-accent); color: #060a00; overflow: hidden; padding: 14px 0; white-space: nowrap; }
  #shopify-section-{{ sid }} .noz-footer__marquee-track { display: inline-flex; align-items: center; gap: 26px; animation: noz-marquee 22s linear infinite; }
  #shopify-section-{{ sid }} .noz-footer__marquee-track span {
    font-family: var(--noz-font-head); font-weight: 900; text-transform: uppercase; letter-spacing: .08em; font-size: .9rem; }
  #shopify-section-{{ sid }} .noz-footer__marquee-track i { display: inline-flex; }
  @keyframes noz-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  #shopify-section-{{ sid }} .noz-footer__top {
    display: grid; grid-template-columns: 1.1fr 1.4fr; gap: clamp(40px,6vw,90px);
    padding-top: clamp(56px,7vw,96px); padding-bottom: clamp(40px,5vw,64px); }
  #shopify-section-{{ sid }} .noz-footer__logo {
    font-family: var(--noz-font-head); font-weight: 900; font-size: 2.6rem; color: var(--noz-white); letter-spacing: .02em; }
  #shopify-section-{{ sid }} .noz-footer__tagline {
    font-family: var(--noz-font-head); font-weight: 700; text-transform: uppercase; letter-spacing: .12em;
    color: var(--noz-accent); font-size: .8rem; margin: 12px 0 0; }
  #shopify-section-{{ sid }} .noz-footer__blurb { color: var(--noz-muted); margin: 18px 0 0; max-width: 40ch; line-height: 1.6; }
  #shopify-section-{{ sid }} .noz-footer__social { display: flex; gap: 12px; margin-top: 24px; }
  #shopify-section-{{ sid }} .noz-footer__social a {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--noz-line-strong);
    display: inline-flex; align-items: center; justify-content: center; color: var(--noz-white); transition: .3s; }
  #shopify-section-{{ sid }} .noz-footer__social a:hover { border-color: var(--noz-accent); color: var(--noz-accent); transform: translateY(-3px); }

  #shopify-section-{{ sid }} .noz-footer__cols {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 32px; }
  #shopify-section-{{ sid }} .noz-footer__col-title {
    font-family: var(--noz-font-head); font-weight: 700; text-transform: uppercase; letter-spacing: .14em;
    font-size: .74rem; color: var(--noz-white); margin: 0 0 16px; }
  #shopify-section-{{ sid }} .noz-footer__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  #shopify-section-{{ sid }} .noz-footer__col a { color: var(--noz-muted); text-decoration: none; font-size: .92rem; transition: color .25s; }
  #shopify-section-{{ sid }} .noz-footer__col a:hover { color: var(--noz-accent); }
  #shopify-section-{{ sid }} .noz-footer__news p { color: var(--noz-muted); font-size: .9rem; margin: 0 0 16px; line-height: 1.5; }
  #shopify-section-{{ sid }} .noz-footer__field {
    display: flex; gap: 8px; background: var(--noz-surface); border: 1px solid var(--noz-line-strong); border-radius: 999px; padding: 6px; }
  #shopify-section-{{ sid }} .noz-footer__field:focus-within { border-color: var(--noz-accent); }
  #shopify-section-{{ sid }} .noz-footer__field input {
    flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--noz-white); padding: 6px 12px; font-size: .9rem; }
  #shopify-section-{{ sid }} .noz-footer__field input::placeholder { color: var(--noz-muted-2); }
  #shopify-section-{{ sid }} .noz-footer__field button {
    flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer;
    background: var(--noz-accent); color: #060a00; display: inline-flex; align-items: center; justify-content: center; transition: transform .3s; }
  #shopify-section-{{ sid }} .noz-footer__field button:hover { transform: translateX(2px); }
  #shopify-section-{{ sid }} .noz-footer__news .noz-form-msg { margin-top: 10px; font-size: .8rem; }

  #shopify-section-{{ sid }} .noz-footer__bottom {
    border-top: 1px solid var(--noz-line); padding-top: 24px; padding-bottom: 8px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  #shopify-section-{{ sid }} .noz-footer__bottom p, #shopify-section-{{ sid }} .noz-footer__bottom a {
    color: var(--noz-muted-2); font-size: .8rem; margin: 0; text-decoration: none; }
  #shopify-section-{{ sid }} .noz-footer__bottom a:hover { color: var(--noz-accent); }

  @media (max-width: 849px) {
    #shopify-section-{{ sid }} .noz-footer__top { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .noz-footer__marquee-track { animation: none; }
  }
{% endstyle %}

{% schema %}
{
  "name": "NOZ · Footer",
  "tag": "section",
  "class": "noz-section-wrapper",
  "settings": [
    { "type": "header", "content": "Marca" },
    { "type": "text", "id": "logo_text", "label": "Logo (texto)", "default": "NOZ" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Respira mejor. Rinde más." },
    { "type": "textarea", "id": "blurb", "label": "Descripción", "default": "Tiras nasales de alto rendimiento diseñadas para optimizar tu flujo de aire." },
    { "type": "header", "content": "Redes sociales" },
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostrar newsletter", "default": true },
    { "type": "text", "id": "news_heading", "label": "Título newsletter", "default": "Newsletter" },
    { "type": "textarea", "id": "news_text", "label": "Texto newsletter", "default": "Suscríbete y sé el primero en respirar la diferencia." },
    { "type": "header", "content": "Marquee" },
    { "type": "checkbox", "id": "show_marquee", "label": "Mostrar marquee superior", "default": true },
    { "type": "text", "id": "marquee_text", "label": "Texto (separa con ·)", "default": "Abre tu respiración · Desbloquea tu rendimiento · Vive NOZ" },
    { "type": "header", "content": "Legal" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "NOZ" },
    { "type": "text", "id": "rights", "label": "Derechos", "default": "Todos los derechos reservados." },
    { "type": "text", "id": "legal_label", "label": "Enlace legal (texto)", "default": "Política de privacidad" },
    { "type": "url", "id": "legal_link", "label": "Enlace legal (URL)" },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "accent_color", "label": "Color de acento", "default": "#C6F000" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#080808" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Producto" },
        { "type": "link_list", "id": "link_list", "label": "Menú", "info": "Recomendado. Si lo usas, se ignoran los enlaces manuales." },
        { "type": "header", "content": "Enlaces manuales (alternativa)" },
        { "type": "text", "id": "l1_label", "label": "Enlace 1" }, { "type": "url", "id": "l1_link", "label": "URL 1" },
        { "type": "text", "id": "l2_label", "label": "Enlace 2" }, { "type": "url", "id": "l2_link", "label": "URL 2" },
        { "type": "text", "id": "l3_label", "label": "Enlace 3" }, { "type": "url", "id": "l3_link", "label": "URL 3" },
        { "type": "text", "id": "l4_label", "label": "Enlace 4" }, { "type": "url", "id": "l4_link", "label": "URL 4" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "NOZ · Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Producto", "l1_label": "Cómo funciona", "l2_label": "Beneficios", "l3_label": "Para quién", "l4_label": "FAQ" } },
        { "type": "menu", "settings": { "heading": "Marca", "l1_label": "Sobre NOZ", "l2_label": "Journal", "l3_label": "Contacto" } }
      ]
    }
  ]
}
{% endschema %}
