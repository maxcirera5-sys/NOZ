{%- comment -%}
  NOZ · Section 05 — WHY BREATHING MATTERS (infographic)
  Oxygen journey pipeline + performance stats.
{%- endcomment -%}
{% render 'noz-head' %}

{%- liquid
  assign sid = section.id
  assign acc = section.settings.accent_color
  assign bg = section.settings.bg_color
  assign nodes = section.blocks | where: 'type', 'node'
  assign stats = section.blocks | where: 'type', 'stat'
-%}

<section class="noz noz-section noz-why" id="noz-why-{{ sid }}"
  style="--noz-accent: {{ acc }}; --noz-bg: {{ bg }};">
  <div class="noz-wrap">
    <div class="noz-head noz-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="noz-eyebrow noz-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="noz-h2 noz-reveal" data-delay="1">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}<p class="noz-lead noz-reveal" data-delay="2">{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>

    {%- if nodes.size > 0 -%}
      <ol class="noz-why__pipeline" aria-label="El recorrido del oxígeno">
        {%- for block in nodes -%}
          <li class="noz-why__node noz-reveal" data-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="noz-why__node-ico">{% render 'noz-icon', icon: block.settings.icon, size: 26 %}</span>
            <span class="noz-why__node-step">Paso {{ forloop.index }}</span>
            <h3 class="noz-why__node-title">{{ block.settings.title }}</h3>
            <p class="noz-why__node-text">{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if stats.size > 0 -%}
      <div class="noz-why__stats">
        {%- for block in stats -%}
          <div class="noz-why__stat noz-reveal" data-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="noz-why__stat-num"
              data-count="{{ block.settings.value }}"
              data-decimals="{{ block.settings.decimals }}"
              data-prefix="{{ block.settings.prefix }}"
              data-suffix="{{ block.settings.suffix }}">{{ block.settings.prefix }}0{{ block.settings.suffix }}</span>
            <span class="noz-why__stat-label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="noz-why__note noz-reveal">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  #shopify-section-{{ sid }} .noz-why__pipeline {
    list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat({{ nodes.size }}, minmax(0,1fr)); gap: clamp(14px,1.6vw,22px); position: relative; }
  #shopify-section-{{ sid }} .noz-why__pipeline::before {
    content: ""; position: absolute; left: 6%; right: 6%; top: 34px; height: 2px;
    background: linear-gradient(90deg, transparent, var(--noz-line-strong) 12%, var(--noz-line-strong) 88%, transparent);
    z-index: 0; }
  #shopify-section-{{ sid }} .noz-why__node { position: relative; z-index: 1; text-align: center; padding: 0 6px; }
  #shopify-section-{{ sid }} .noz-why__node-ico {
    width: 68px; height: 68px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
    background: var(--noz-bg); border: 2px solid var(--noz-accent); color: var(--noz-accent); margin-bottom: 16px;
    box-shadow: 0 0 0 6px rgba(198,240,0,.08); }
  #shopify-section-{{ sid }} .noz-why__node-step {
    display: block; font-family: var(--noz-font-head); font-weight: 700; text-transform: uppercase;
    letter-spacing: .18em; font-size: .62rem; color: var(--noz-muted-2); margin-bottom: 6px; }
  #shopify-section-{{ sid }} .noz-why__node-title {
    font-family: var(--noz-font-head); font-weight: 900; text-transform: uppercase; color: var(--noz-white);
    font-size: 1.05rem; margin: 0 0 8px; }
  #shopify-section-{{ sid }} .noz-why__node-text { font-size: .88rem; line-height: 1.5; color: var(--noz-muted); margin: 0; }

  #shopify-section-{{ sid }} .noz-why__stats {
    margin-top: clamp(48px,6vw,80px); display: grid; grid-template-columns: repeat({{ stats.size }}, 1fr);
    gap: 20px; border-top: 1px solid var(--noz-line); border-bottom: 1px solid var(--noz-line); padding: 40px 0; }
  #shopify-section-{{ sid }} .noz-why__stat { text-align: center; }
  #shopify-section-{{ sid }} .noz-why__stat-num {
    display: block; font-family: var(--noz-font-head); font-weight: 900; line-height: 1;
    font-size: clamp(2.6rem, 6vw, 4.4rem); color: var(--noz-accent); }
  #shopify-section-{{ sid }} .noz-why__stat-label { display: block; margin-top: 12px; color: var(--noz-muted);
    font-size: .9rem; max-width: 24ch; margin-inline: auto; }
  #shopify-section-{{ sid }} .noz-why__note { margin: 26px auto 0; text-align: center; max-width: 60ch;
    font-size: .78rem; color: var(--noz-muted-2); }

  @media (max-width: 849px) {
    #shopify-section-{{ sid }} .noz-why__pipeline { grid-template-columns: 1fr; gap: 26px; }
    #shopify-section-{{ sid }} .noz-why__pipeline::before {
      left: 33px; right: auto; top: 6%; bottom: 6%; width: 2px; height: auto; }
    #shopify-section-{{ sid }} .noz-why__node { text-align: left; display: grid; grid-template-columns: 68px 1fr; column-gap: 20px; align-items: start; }
    #shopify-section-{{ sid }} .noz-why__node-ico { grid-row: 1 / span 3; margin-bottom: 0; }
    #shopify-section-{{ sid }} .noz-why__stats { grid-template-columns: 1fr; gap: 32px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "NOZ · Por qué respirar",
  "tag": "section",
  "class": "noz-section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por qué importa" },
    { "type": "text", "id": "title", "label": "Título", "default": "Respirar bien lo cambia todo." },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "El oxígeno es tu combustible. Cuanto mejor entra el aire, mejor rinde tu cuerpo — antes, durante y después del esfuerzo." },
    { "type": "textarea", "id": "footnote", "label": "Nota al pie", "default": "Valores ilustrativos. NOZ no sustituye consejo médico." },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "accent_color", "label": "Color de acento", "default": "#C6F000" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#080808" }
  ],
  "blocks": [
    {
      "type": "node",
      "name": "Paso del recorrido",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icono", "options": [
          { "value": "airflow", "label": "Flujo de aire" },
          { "value": "nose", "label": "Nariz" },
          { "value": "lungs", "label": "Pulmones" },
          { "value": "oxygen", "label": "Oxígeno" },
          { "value": "cardio", "label": "Corazón" },
          { "value": "performance", "label": "Rendimiento" } ], "default": "airflow" },
        { "type": "text", "id": "title", "label": "Título", "default": "Entrada de aire" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "El aire entra por la nariz, tu primer y mejor filtro natural." }
      ]
    },
    {
      "type": "stat",
      "name": "Dato",
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "20" },
        { "type": "text", "id": "prefix", "label": "Prefijo", "default": "+" },
        { "type": "text", "id": "suffix", "label": "Sufijo", "default": "%" },
        { "type": "text", "id": "decimals", "label": "Decimales", "default": "0" },
        { "type": "text", "id": "label", "label": "Descripción", "default": "más flujo de aire potencial" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "NOZ · Por qué respirar",
      "blocks": [
        { "type": "node", "settings": { "icon": "nose", "title": "Entrada de aire", "text": "El aire entra por la nariz, tu filtro natural. Si las vías están estrechas, entra menos." } },
        { "type": "node", "settings": { "icon": "lungs", "title": "Llega a los pulmones", "text": "Un mayor flujo de aire lleva más oxígeno a los alvéolos con cada respiración." } },
        { "type": "node", "settings": { "icon": "oxygen", "title": "Pasa a la sangre", "text": "El oxígeno viaja por la sangre hasta los músculos que están trabajando." } },
        { "type": "node", "settings": { "icon": "performance", "title": "Impulsa el rendimiento", "text": "Más oxígeno = más energía, mejor resistencia y una recuperación más rápida." } },
        { "type": "stat", "settings": { "value": "20", "prefix": "+", "suffix": "%", "decimals": "0", "label": "más flujo de aire potencial" } },
        { "type": "stat", "settings": { "value": "40", "prefix": "-", "suffix": "%", "decimals": "0", "label": "menos resistencia nasal al aire" } },
        { "type": "stat", "settings": { "value": "0", "prefix": "", "suffix": "", "decimals": "0", "label": "fármacos: mejora 100% mecánica" } }
      ]
    }
  ]
}
{% endschema %}
