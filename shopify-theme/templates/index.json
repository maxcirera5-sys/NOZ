      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"noz-marquee-wrap\"><div class=\"noz-marquee\" role=\"presentation\"><div class=\"noz-marquee__track\"><span>Respira más</span><i aria-hidden=\"true\">✦</i><span>Rinde más</span><i aria-hidden=\"true\">✦</i><span>NOZ Sport</span><i aria-hidden=\"true\">✦</i><span>Cardio</span><i aria-hidden=\"true\">✦</i><span>Fuerza</span><i aria-hidden=\"true\">✦</i><span>Resistencia</span><i aria-hidden=\"true\">✦</i><span>Respira más</span><i aria-hidden=\"true\">✦</i><span>Rinde más</span><i aria-hidden=\"true\">✦</i><span>NOZ Sport</span><i aria-hidden=\"true\">✦</i><span>Cardio</span><i aria-hidden=\"true\">✦</i><span>Fuerza</span><i aria-hidden=\"true\">✦</i><span>Resistencia</span><i aria-hidden=\"true\">✦</i></div></div></div>",
